FROM registry.access.redhat.com/ubi8/ubi:latest

VOLUME /repo

RUN dnf update -y && \
    dnf install -y python3-devel rpm-build make

WORKDIR /repo
ENV DIST_VERSION 8
# RELEASE is supplied at runtime (podman run -e RELEASE=...); the Makefile reads it
# from the environment (RELEASE ?=), so no git is needed inside the container.
ENTRYPOINT ["make", "_container_build"]
